# Copy this file to .env and replace every placeholder with the real value.
# .env is ignored by git; this file is tracked and must never contain real values.

# ===== Site =====
# Public base URL of the deployed site, without trailing slash (e.g. the GitHub Pages or custom domain URL).
# Used for canonical links, hreflang, sitemap and Open Graph. In CI it comes from the repo variable SITE_URL.
SITE_URL=your_site_url_here
