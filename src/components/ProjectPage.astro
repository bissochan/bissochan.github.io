---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pipeline from '@/components/Pipeline.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { localizePath, useTranslations, type Lang } from '@/i18n/ui';
import { projectSlug, type Project } from '@/lib/content';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { data } = project;
const { Content } = await render(project);
const slug = projectSlug(project);
const back = `${localizePath('/', lang)}#${t('section.projects')}`;
---

<BaseLayout lang={lang} path={`/projects/${slug}`} title={data.title} description={data.summary} type="article">
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <a href={back} class="font-mono text-sm text-muted-foreground hover:text-brand">← {t('projects.back')}</a>

    <header class="mt-6">
      <p class="font-mono text-xs text-brand" aria-hidden="true">// projects/{slug}</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-muted-foreground">{data.summary}</p>

      <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
        <div>
          <dt class="font-mono text-xs text-muted-foreground">{t('projects.role')}</dt>
          <dd class="mt-1">{data.role}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs text-muted-foreground">{t('projects.period')}</dt>
          <dd class="mt-1">{data.period}</dd>
        </div>
        <div class="sm:col-span-2">
          <dt class="font-mono text-xs text-muted-foreground">{t('projects.stack')}</dt>
          <dd class="mt-2">
            <ul class="flex flex-wrap gap-1.5">
              {
                data.stack.map((s) => (
                  <li>
                    <Badge variant="outline" className="font-mono">
                      {s}
                    </Badge>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>

      {
        (data.live || data.repo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {data.live && (
              <a class={buttonVariants()} href={data.live} target="_blank" rel="noopener noreferrer">
                {t('projects.live')} ↗
              </a>
            )}
            {data.repo && (
              <a class={buttonVariants({ variant: 'outline' })} href={data.repo} target="_blank" rel="noopener noreferrer">
                {t('projects.code')} ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {data.pipeline && <Pipeline steps={data.pipeline} label={t('projects.pipeline')} />}

    <Separator className="my-8" />

    <div class="prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .prose-content :global(h2::before) {
    content: '## ';
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 0.9em;
  }
  .prose-content :global(p),
  .prose-content :global(li) {
    line-height: 1.75;
    color: color-mix(in oklch, var(--foreground) 90%, transparent);
  }
  .prose-content :global(p + p) {
    margin-top: 1rem;
  }
  .prose-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.6rem;
  }
  .prose-content :global(li::marker) {
    color: var(--brand);
  }
  .prose-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: var(--muted);
  }
  .prose-content :global(strong) {
    font-weight: 600;
    color: var(--foreground);
  }
</style>
