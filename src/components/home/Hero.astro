---
import { Image } from 'astro:assets';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import SocialLinks from '@/components/SocialLinks.astro';
import photo from '@/assets/photo.png';
import { site } from '@/data/site';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto max-w-5xl px-4 pt-10 pb-16 sm:px-6 sm:pt-20 sm:pb-24" aria-labelledby="hero-title">
  <div class="flex flex-col-reverse gap-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-2xl">
      <p class="font-mono text-sm text-muted-foreground">
        <span class="text-brand">~/luca-bissoli</span> $ <span class="typing">whoami</span>
      </p>

      <h1 id="hero-title" class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{site.name}</h1>
      <p class="mt-2 text-lg font-medium text-foreground/90 sm:text-xl">{t('hero.role')}</p>

      {
        site.openToWork && (
          <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-brand/40 bg-brand/10 px-3 py-1 text-xs font-medium sm:text-sm">
            <span class="relative flex size-2" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-brand opacity-60 motion-reduce:hidden" />
              <span class="relative inline-flex size-2 rounded-full bg-brand" />
            </span>
            {t('hero.open')}
          </p>
        )
      }

      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t('hero.pitch')}</p>
      <p class="mt-3 flex items-start gap-2 text-sm text-muted-foreground">
        <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 10c0 4.99-5.54 10.19-7.4 11.8a1 1 0 0 1-1.2 0C9.54 20.19 4 14.99 4 10a8 8 0 0 1 16 0"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {t('hero.location')}
      </p>

      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t('nav.skills')}>
        {
          site.heroTags.map((tag) => (
            <li>
              <Badge variant="outline" className="font-mono">
                {tag}
              </Badge>
            </li>
          ))
        }
      </ul>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a class={buttonVariants({ size: 'lg' })} href={`mailto:${site.email}`}>{t('hero.email')}</a>
        {
          site.cvPdf && (
            <a class={buttonVariants({ variant: 'outline', size: 'lg' })} href={site.cvPdf} download>
              {t('hero.cv')}
            </a>
          )
        }
        <SocialLinks lang={lang} />
      </div>
    </div>

    <Image
      src={photo}
      alt={t('hero.photoAlt')}
      widths={[112, 176, 250]}
      sizes="(min-width: 640px) 176px, 112px"
      loading="eager"
      fetchpriority="high"
      class="size-28 shrink-0 rounded-full border border-border object-cover shadow-sm sm:size-44"
    />
  </div>
</section>

<style>
  .typing {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    border-right: 0.55em solid var(--brand);
    box-sizing: content-box;
    width: 6ch;
    animation:
      typing 0.9s steps(6, end) 0.3s both,
      caret 1s step-end infinite;
  }
  @keyframes typing {
    from {
      width: 0;
    }
    to {
      width: 6ch;
    }
  }
  @keyframes caret {
    50% {
      border-color: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typing {
      animation: none;
    }
  }
</style>
