---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { localizePath, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  /** Path without locale prefix, e.g. "/" or "/projects/vollai". */
  path: string;
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { lang, path, title, description, type = 'website' } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} · ${site.name}` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const siteUrl = Astro.site ?? new URL('https://bissochan.github.io');
const canonical = new URL(localizePath(path, lang), siteUrl).href;
const alternates = (['en', 'it'] as const).map((l) => ({ lang: l, href: new URL(localizePath(path, l), siteUrl).href }));
const ogImage = new URL('/og.png', siteUrl).href;

const sameAs = [site.github, site.linkedin].filter(Boolean);
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', siteUrl).href,
  image: new URL('/og.png', siteUrl).href,
  jobTitle: 'Software Engineer',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Verona', addressCountry: 'IT' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Trento', url: 'https://www.unitn.it/' },
  knowsAbout: ['Machine Learning', 'Python', 'C#', '.NET', 'FastAPI', 'Docker', 'Kubernetes', 'Retrieval-Augmented Generation'],
  knowsLanguage: ['it', 'en'],
  sameAs,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Latin subsets of the two fonts: preloaded so text does not shift when they swap in. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Apply the saved/system theme before first paint, so there is no flash of the wrong theme. -->
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:shadow"
    >
      {t('skip')}
    </a>
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
